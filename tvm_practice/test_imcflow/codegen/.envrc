source_up
export TVM_LOG_DEBUG=""
export IMCFLOW_RUNNER=py # py, rtl, both
# Debug logging only (no effect on compile output). Default off for speed;
# the layout-legalization debug dump is O(N) per node and slows deep models.
# For verbose logs run a one-off: IMCFLOW_DEBUG=1 python main.py ...
export IMCFLOW_DEBUG=0
export IMCFLOW_DEBUG_COMPUTE=1
export IMCFLOW_DEBUG_NOC=0
export IMCFLOW_BUGFIX_OVERFLOW_SW=1
export IMCFLOW_DUMP_PSUM_MAP=1
export IMCFLOW_BIG_IMEM="0"
export SRAM_BACKDOOR=1
export TF_CPP_MIN_LOG_LEVEL=3
export IMCFLOW_HOST_OS=baremetal # linux, baremetal
export IMCFLOW_HOST_ISA=x86 # arm, x86
# export IMCFLOW_HOST_OS=linux # linux, baremetal
# export IMCFLOW_HOST_ISA=arm # arm, x86
export IMCFLOW_ADDR=0xa0000000
export IMCFLOW_LEN=0x100000
export INT_ACK_GEN_ADDR=0xa0110000
export INT_ACK_GEN_LEN=0x10000

export DEBUG_EXE=0
export IMCFLOW_NO_PERKERNEL_WARMUP=1

export TVM_CODEGEN_TEST_DIR="/root/project/tvm/tvm_practice/test_imcflow/codegen"
export GEM5_RTL_TEST_DIR="/root/project/imcflow/pmap/ISA_sim/gem5/tests/imcflow/rtl_runner"

export PYTHONPATH=$PYTHONPATH:/root/project/tvm/tvm_practice/test_imcflow/codegen/tools:/root/project/CIM
dotenv