export LLVM_PATH="/usr/lib/llvm-17"
export PATH="${LLVM_PATH}/bin:${PATH}"

export TVM_LOG_DEBUG="DEFAULT=3"
# TVM_HOME = the main checkout (for the compiled C++ build/.so, which the
# worktree does not have). But the PYTHON sources come from THIS worktree so
# our branch's Python changes are what run. WORKTREE_ROOT is this worktree.
export TVM_HOME="/root/project/tvm"
WORKTREE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# The prebuilt libtvm lives in the main checkout's build dir.
export TVM_LIBRARY_PATH="${TVM_HOME}/build"
# export TVM_INCLUDE_PATH="${CONDA_PREFIX}"

# VTA
export VTA_HW_PATH=${TVM_HOME}/3rdparty/vta-hw

# ★ worktree python FIRST so this branch's Python sources win; then main tree
# python is unnecessary (same tree structure) but kept as a fallback.
export PYTHONPATH="${WORKTREE_ROOT}/python:${WORKTREE_ROOT}/vta/python:${PYTHONPATH}"
export PATH="${TVM_HOME}/build/bin:${PATH}"

export LD_LIBRARY_PATH="${TVM_HOME}/build:${LD_LIBRARY_PATH}"